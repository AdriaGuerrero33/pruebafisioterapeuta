# =====================================================================
#  Configuración de la fuente de datos
# =====================================================================
#
#  Por defecto el dashboard usa datos de DEMO (el CRM simulado que está
#  en src/data/mockClients.ts). Para conectarlo a tu Google Sheet real,
#  copia este archivo a ".env" y sigue UNA de las dos opciones de abajo.
#
#      cp .env.example .env
#
#  El ID de tu CRM ya viene configurado en el código, así que normalmente
#  solo necesitas poner VITE_DATA_SOURCE=sheets.
# ---------------------------------------------------------------------

# "mock" (demo) | "sheets" (Google Sheets real)
VITE_DATA_SOURCE=mock


# --- Opción A (RECOMENDADA): "Publicar en la web" en CSV ----------------
#  En tu hoja: Archivo → Compartir → Publicar en la web → elige la pestaña
#  → formato CSV → Publicar → copia la URL aquí. Es la opción que funciona
#  de forma más fiable desde el navegador.
VITE_GOOGLE_SHEET_CSV_URL=


# --- Opción B: por ID de hoja (debe estar compartida con el enlace) -----
#  Requiere: Compartir → "Cualquier persona con el enlace: Lector".
#  Ya viene puesto el ID de tu CRM; cámbialo solo si usas otra hoja.
VITE_GOOGLE_SHEET_ID=10lwbPW2Uavxnz9-Qmg9m5Ycm7QFJQUX6XOs9iBrh43o
#  Nombre de la pestaña con el listado de clientes (vacío = primera pestaña)
VITE_GOOGLE_SHEET_NAME=
