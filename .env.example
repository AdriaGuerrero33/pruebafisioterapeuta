# =====================================================================
#  Configuración de la fuente de datos
# =====================================================================
#
#  Por defecto el dashboard usa datos de DEMO (el CRM simulado que está
#  en src/data/mockClients.ts). Para conectarlo a tu Google Sheet real:
#
#  1. Copia este archivo a ".env" (o ".env.local")
#  2. Pon VITE_DATA_SOURCE en "sheets"
#  3. Rellena el ID de tu hoja (está en la URL de Google Sheets, entre
#     "/d/" y "/edit") y el nombre de la pestaña que contiene el CRM.
#  4. En Google Sheets: Archivo → Compartir → Publicar en la web,
#     o pon la hoja como "Cualquier persona con el enlace: Lector".
#
#  Más detalle en el README (sección "Conectar con Google Sheets").
# ---------------------------------------------------------------------

# "mock" (demo) | "sheets" (Google Sheets real)
VITE_DATA_SOURCE=mock

# ID de la hoja de Google (parte de la URL entre /d/ y /edit)
VITE_GOOGLE_SHEET_ID=

# Nombre de la pestaña donde está el listado de clientes del CRM
VITE_GOOGLE_SHEET_NAME=Clientes
